generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id             String   @id @default(cuid())
  name           String
  company        String?
  department     String?
  title          String?
  email          String?
  phone          String?
  address        String?
  type           String?
  discountRate   Float?
  sansanPersonId String?  @unique
  leadStatus     String?
  leadSource     String?
  temperature    String?
  lastContactDate DateTime?
  nextAction     String?
  nextActionDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  orders         Order[]
  shipments      Shipment[]
}

model Deal {
  id                String   @id @default(cuid())
  title             String
  description       String?
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage             String   @default("inquiry")
  amount            Int?
  expectedCloseDate DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tasks             Task[]
  notes             Note[]
}

model Note {
  id              String   @id @default(cuid())
  title           String
  body            String
  appleNoteId     String?  @unique
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  crmNote         String?
  status          String   @default("new")
  appleCreatedAt  DateTime?
  appleModifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Member {
  id          String   @id @default(cuid())
  name        String
  role        String?
  color       String   @default("#3b82f6")
  type        String   @default("staff")  // staff (社員) | worker (内職)
  phone       String?
  specialties String?  // 内職の得意商品（カンマ区切り）
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productionAssignments ProductionAssignment[]
}

model Product {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  series          String?      // 西陣 | 友禅 | 伊勢 | その他
  size            String?      // 2.6寸, 3.3寸 など
  retailPrice     Int?         // 上代（小売価格、税抜）
  costRatio       Float?       // 原価率（上代逆算用、デフォルト 0.30 = 30%）
  wholesalePrice  Int?         // [標準] 標準卸価格（顧客別未設定時の参考値）
  workerCost      Int?         // [legacy] 旧 内職単価（後方互換用）
  salesCost       Int?         // 営業費（個あたり、運賃含む）
  packagingCost   Int?         // [legacy] 梱包費 → 出荷費に統合済み
  shippingCost    Int?         // [legacy] 運賃 → 営業費に統合済み
  outboundCost    Int?         // 出荷費（個あたり、梱包含む）
  mgmtCost        Int?         // 管理費（個あたり）
  cutHeight       Int?         // 裁断 縦 (cm)
  cutWidth        Int?         // 裁断 横 (cm)
  sizeW           Float?       // 商品サイズ 幅 W (cm)
  sizeH           Float?       // 商品サイズ 高さ H (cm)
  sizeD           Float?       // 商品サイズ 奥行 D (cm)
  weightG         Float?       // 重さ (g)
  description     String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  orderItems      OrderItem[]
  productions     Production[]
  shipments       Shipment[]
  inventory       Inventory?
  developments    Development[]
  forecasts       ProductForecast[]
  costSteps       ProductCostStep[]
  materials       ProductMaterial[]
}

model ProductCostStep {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  step      String   // 工程名 例: 裁断 / 縫製 / 仕上げ
  unitCost  Int      // 1個あたり単価（内製の場合は作業単価、外注は総額）
  quantity  Int      @default(1)  // 内製のショット数。外注は通常 1
  category  String   @default("制作費")  // "制作費" | "裁断費"
  subType   String?  // "内製" | "外注"（主に裁断費で使用）
  sortOrder Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductMaterial {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String?   // 資材マスタへの参照（任意）
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  name       String    // 例: 西陣裂A、ボタン、糸（マスタからのコピー or 手入力）
  category   String    @default("other")  // "fabric" | "other"
  unitPrice  Int       // 単価
  unitType   String    @default("piece")  // "meter" | "piece" | "set"
  yieldCount Int       @default(1)        // [生地] 使用Mから取れる個数
  usedMeters Float     @default(1)        // [生地] 使用M数（例: 0.9）
  usageCount Float     @default(1)        // [資材/梱包資材] 1個あたりの使用数（例: ボタン2個）
  pairId     String?   // 表地と裏地（不織）をペアで管理（同じ裁断で連動）
  sortOrder  Int       @default(0)
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Material {
  id           String   @id @default(cuid())
  code         String?  @unique
  name         String
  category     String   @default("その他")  // MaterialCategory.name を保存
  unitPrice    Int
  unitType     String   @default("piece")   // "meter" | "piece" | "set"
  defaultYield Int?     // [legacy] 未使用
  fabricWidth  Int?     // 生地の巾 (cm) - 生地カテゴリのみ使用
  active       Boolean  @default(true)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  productMaterials ProductMaterial[]
}

model MaterialCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("bg-gray-100 text-gray-700")
  unitType  String   @default("piece")  // このカテゴリのデフォルト単位
  parentId  String?  // 階層構造: top → intermediate → leaf
  kind      String   @default("leaf")   // "top" | "intermediate" | "leaf"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  orderDate   DateTime
  dueDate     DateTime?
  status      String   @default("pending")  // pending | in_progress | completed | cancelled
  note        String?
  items       OrderItem[]
  shipments   Shipment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int
  monthlyPlans  String?  // JSON: {"2026-04": 100, "2026-05": 200}
  weeklyPlans   String?  // JSON: 週別配分
  shippedQty    Int      @default(0)
  unitPrice     Int?     // 単価（注文時の価格、Productからコピー）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Production {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  requestDate     DateTime
  dueDate         DateTime?
  status          String   @default("requested")  // requested | in_progress | delivered
  note            String?
  assignments     ProductionAssignment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductionAssignment {
  id            String     @id @default(cuid())
  productionId  String
  production    Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  workerId      String
  worker        Member     @relation(fields: [workerId], references: [id])
  step          String?    // 工程名（裁断/縫製/仕上げ など、任意）
  quantity      Int        // この内職への割当数
  deliveredQty  Int        @default(0)
  deliveredDate DateTime?
  status        String     @default("requested")  // requested | in_progress | delivered
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Development {
  id           String   @id @default(cuid())
  title        String
  description  String?
  status       String   @default("active")  // active | released | paused | abandoned
  initiator    String?  // 誰が発案
  startDate    DateTime?
  releasedDate DateTime?
  productId    String?  // リリース時の商品マスタ紐付け
  product      Product? @relation(fields: [productId], references: [id])
  notes        String?
  tasks        Task[]
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shipment {
  id          String   @id @default(cuid())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  shipDate    DateTime
  quantity    Int
  amount      Int      // 出荷時の売上額
  status      String   @default("scheduled")  // scheduled | shipped | delivered
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductForecast {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  month     String   // "2026-05"
  forecast  Int
  source    String?  // manual | prev_year | moving_avg
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, month])
}

model PriceListSnapshot {
  id        String   @id @default(cuid())
  name      String   // 例: "2026年5月価格改定"
  note      String?  // メモ（理由など）
  snappedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     PriceListItem[]
}

model PriceListItem {
  id          String   @id @default(cuid())
  snapshotId  String
  snapshot    PriceListSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  productId   String   // 元商品ID（参照のため、削除後も値は保持）
  productCode String?
  productName String
  series      String?
  cost        Int      @default(0)        // 当時の原価
  retailPrice Int?                         // 当時の上代
  prices      String                       // JSON: { "AmazonJP": 150, "京都問屋": 45, ... }
  createdAt   DateTime @default(now())
  @@index([snapshotId])
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  stock       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Activity {
  id           String   @id @default(cuid())
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type         String
  content      String
  activityDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId        String?
  deal          Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  developmentId String?
  development   Development? @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  priority      String   @default("medium")
  status        String   @default("todo")
  forStage      String?
  assignee      String?
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
