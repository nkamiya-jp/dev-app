generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id             String   @id @default(cuid())
  name           String
  company        String?
  department     String?
  title          String?
  email          String?
  phone          String?
  address        String?
  type           String?
  discountRate   Float?
  sansanPersonId String?  @unique
  leadStatus     String?
  leadSource     String?
  temperature    String?
  lastContactDate DateTime?
  nextAction     String?
  nextActionDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
}

model Deal {
  id                String   @id @default(cuid())
  title             String
  description       String?
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage             String   @default("inquiry")
  amount            Int?
  expectedCloseDate DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tasks             Task[]
  notes             Note[]
}

model Note {
  id              String   @id @default(cuid())
  title           String
  body            String
  appleNoteId     String?  @unique
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  crmNote         String?
  status          String   @default("new")
  appleCreatedAt  DateTime?
  appleModifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Member {
  id        String   @id @default(cuid())
  name      String
  role      String?
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id           String   @id @default(cuid())
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type         String
  content      String
  activityDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  priority    String   @default("medium")
  status      String   @default("todo")
  forStage    String?
  assignee    String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
