generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id             String   @id @default(cuid())
  name           String
  company        String?
  department     String?
  title          String?
  email          String?
  phone          String?
  address        String?
  type           String?
  discountRate   Float?
  closingDay     Int?     // 締日（1-31、null/0=末日締め）。月次売上の月判定に使用
  paymentMonthOffset Int? // 入金までの月数（1=翌月, 2=翌々月）。未設定=翌月扱い
  paymentDay     Int?     // 入金日（null/0=末日, 10=10日 など）
  sansanPersonId String?  @unique
  leadStatus     String?
  leadSource     String?
  temperature    String?
  lastContactDate DateTime?
  nextAction     String?
  nextActionDate DateTime?
  // 毎日注文の取引先（受注進捗ボード・Slack取り込みの対象外）と、Slack投稿での呼び名（カンマ区切り）
  dailyOrder   Boolean  @default(false)
  orderAliases String?
  developments Development[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  orders         Order[]
  shipments      Shipment[]
  customerPrices CustomerPrice[]
  oemProducts    Product[]      @relation("OemProducts")
  oemQuotes      OemQuote[]
  salesPlanCells SalesPlanCell[]
}

model Deal {
  id                String   @id @default(cuid())
  title             String
  description       String?
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage             String   @default("inquiry")
  amount            Int?
  expectedCloseDate DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tasks             Task[]
  notes             Note[]
}

model Note {
  id              String   @id @default(cuid())
  title           String
  body            String
  appleNoteId     String?  @unique
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  crmNote         String?
  status          String   @default("new")
  appleCreatedAt  DateTime?
  appleModifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Member {
  id          String   @id @default(cuid())
  name        String
  role        String?
  color       String   @default("#3b82f6")
  type        String   @default("staff")  // staff (社員) | worker (内職)
  phone       String?
  specialties String?  // 内職の得意商品（カンマ区切り）
  active      Boolean  @default(true)
  email       String?  @unique // ログインの照合キー（内職さんは空）
  permission  String?  // president(社長) | staff(スタッフ) | part(パート)。空＝ログイン不可
  departments String?  // 営業、制作、出荷（「、」区切り）
  employment  String   @default("在籍") // 在籍 | 退職（退職はログイン不可）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productionAssignments ProductionAssignment[]
  personalGoals         PersonalGoal[]
}

// ロードマップ：会社の事業目標（年間・四半期）
model BizGoal {
  id        String   @id @default(cuid())
  legacyId  String?  @unique // GAS版の ID（移行の照合用）
  term      String   // 期（例：第10期）
  grain     String   // 年間 | 四半期
  period    String   // 年間 | Q1〜Q4
  goal      String
  kpi       String?
  target    String?
  actual    String?
  owner     String?  // 担当
  status    String?  // 未着手 | 進行中 | 達成 | 未達
  comment   String?  // 社長コメント（全員に見える）
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  personalGoals PersonalGoal[]

  @@index([term])
}

// ロードマップ：個人目標（年間 → 四半期マイルストーン → 月目標）。本人と社長だけが見る
model PersonalGoal {
  id          String   @id @default(cuid())
  legacyId    String?  @unique // GAS版の ID（移行の照合用）
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  term        String   // 期（例：第10期）
  kind        String   // 年間 | 四半期 | 月
  quarter     String?  // Q1〜Q4（月目標は月から決まる）
  month       String?  // YYYY-MM（月目標）
  parentId    String?  // 月→四半期、四半期→年間
  bizGoalId   String?  // どの会社の四半期目標に効くか（四半期マイルストーン）
  bizGoal     BizGoal? @relation(fields: [bizGoalId], references: [id], onDelete: SetNull)
  qtype       String   @default("定量") // 定量 | 定性
  goal        String
  criteria    String?  // 達成基準（定性）／補足（定量）
  kpi         String?
  target      String?
  result      String?  // 実績・結果
  progress    String?  // 未着手 | 進行中 | 達成 | 未達（年間・月）
  weight      Int?     // ウェイト%（四半期）
  selfGrade   String?  // 本人評価 S〜D
  selfComment String?  // 振り返り
  fb          String?  // 社長FB（いつでも本人に見える）
  ceoGrade    String?  // 社長評価（確定後に本人に見える）
  ceoComment  String?  // 社長コメント（確定後に本人に見える）
  status      String   @default("設定中") // 設定中 | 合意済 | 評価中 | 確定
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([memberId, term])
  @@index([bizGoalId])
}

model Product {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  series          String?      // 西陣 | 友禅 | 伊勢 | その他
  size            String?      // 2.6寸, 3.3寸 など
  retailPrice     Int?         // 上代（小売価格、税抜）
  costRatio       Float?       // 原価率（上代逆算用、デフォルト 0.30 = 30%）
  wholesalePrice  Int?         // [標準] 標準卸価格（顧客別未設定時の参考値）
  workerCost      Int?         // [legacy] 旧 内職単価（後方互換用）
  salesCost       Int?         // 営業費（個あたり、運賃含む）
  packagingCost   Int?         // [legacy] 梱包費 → 出荷費に統合済み
  shippingCost    Int?         // [legacy] 運賃 → 営業費に統合済み
  outboundCost    Int?         // 出荷費（個あたり、梱包含む）
  mgmtCost        Int?         // 管理費（個あたり）
  purchaseCost    Int?         // 仕入単価（仕入品のみ。個あたりの仕入原価）
  cutHeight       Int?         // 裁断 縦 (cm)
  cutWidth        Int?         // 裁断 横 (cm)
  usedMeters      Float?       // 生地の使用M（1個作るのに使う長さ。商品ごとに異なる）
  sizeW           Float?       // 商品サイズ 幅 W (cm)
  sizeH           Float?       // 商品サイズ 高さ H (cm)
  sizeD           Float?       // 商品サイズ 奥行 D (cm)
  weightG         Float?       // 重さ (g)
  sortOrder       Int          @default(0)  // 価格表などの表示順（100刻み）
  leadText        String?      // リード文（短いキャッチコピー）
  tags            String?      // 検索用タグ（カンマ区切り 例: がま口,西陣,財布）
  description     String?      // 商品説明文
  shortName       String?      // 略称（梱包カードなど省スペース表示用）
  fnsku           String?      // Amazon FNSKU（商品ラベル用バーコード, 例 X00ABC1234）
  hasNonwoven     Boolean      @default(false)  // 西陣織で不織布を使うか（有/無）
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  orderItems      OrderItem[]
  productions     Production[]
  shipments       Shipment[]
  inventory       Inventory?
  developments    Development[]
  forecasts       ProductForecast[]
  costSteps       ProductCostStep[]
  materials       ProductMaterial[]
  customerPrices  CustomerPrice[]
  aliases         ProductAlias[]
  janItems        JanItem[]
  // OEM：顧客専用の商品（空＝自社商品）。商品一覧・価格表・原価比較には出さない
  ownerContactId      String?
  ownerContact        Contact?   @relation("OemProducts", fields: [ownerContactId], references: [id], onDelete: SetNull)
  oemMultiplier       Float?     // 決めた倍率（普段の量で決めて固定）
  oemIncludePackaging Boolean    @default(false) // 梱包資材を原価に含めるか
  oemPrice            Int?       // 決めたOEM単価（顧客別価格にも入れる）
  oemPricedCost       Int?       // 単価を決めた時の原価（値上がりに気づくため）
  oemPricedAt         DateTime?
  oemQuotes           OemQuote[]
  salesPlans          SalesPlan[]

  @@index([ownerContactId])
}

// OEM見積の履歴（見積を出した時点の原価を控える）
model OemQuote {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quantity         Int      // 普段の注文量（倍率を決める）
  multiplier       Float
  includePackaging Boolean  @default(false)
  unitCost         Int      // 見積時の原価（梱包資材を除く場合は除いた額）
  unitPrice        Int      // 単価（原価×倍率を10円単位に切り上げ）
  extras           String?  // 別途の行 JSON [{label, amount}]
  note             String?
  adopted          Boolean  @default(false) // この見積で単価を決めたか
  createdBy        String?
  createdAt        DateTime @default(now())

  @@index([productId])
}

// 顧客の取扱商品＋個別卸価格。行が存在する = その顧客が取り扱う商品。
// price が null なら「取扱いあり・価格は自動（上代×掛率）」、値ありなら個別価格で上書き。
model CustomerPrice {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Int?     // 個別卸価格（税抜、円）。null=自動計算
  note      String?  // 個別価格の理由メモ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([contactId, productId])
  @@index([contactId])
}

model ProductCostStep {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  step      String   // 工程名 例: 裁断 / 縫製 / 仕上げ
  unitCost  Int      // 1個あたり単価（内製の場合は作業単価、外注は総額）
  quantity  Int      @default(1)  // 内製のショット数。外注は通常 1
  category  String   @default("制作費")  // "制作費" | "裁断費"
  subType   String?  // "内製" | "外注"（主に裁断費で使用）
  sortOrder Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductMaterial {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String?   // 資材マスタへの参照（任意）
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  name       String    // 例: 西陣裂A、ボタン、糸（マスタからのコピー or 手入力）
  category   String    @default("other")  // "fabric" | "other"
  unitPrice  Int       // 単価
  unitType   String    @default("piece")  // "meter" | "piece" | "set"
  yieldCount Int       @default(1)        // [生地] 使用Mから取れる個数
  usedMeters Float     @default(1)        // [生地] 使用M数（例: 0.9）
  usageCount Float     @default(1)        // [資材/梱包資材] 1個あたりの使用数（例: ボタン2個）
  cutH       Float?    // [生地] 裁断したいサイズ 縦 cm（記録用）
  cutW       Float?    // [生地] 裁断したいサイズ 横 cm（記録用）
  cutType    String?   // [生地] 裁断方法 "型抜" | "手裁断"
  pairId     String?   // 表地と裏地（不織）をペアで管理（同じ裁断で連動）
  sortOrder  Int       @default(0)
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Material {
  id           String   @id @default(cuid())
  code         String?  @unique
  name         String
  category     String   @default("その他")  // MaterialCategory.name を保存
  unitPrice    Int
  unitType     String   @default("piece")   // "meter" | "piece" | "set"
  defaultYield Int?     // [legacy] 未使用
  fabricWidth  Int?     // 生地の巾 (cm) - 生地カテゴリのみ使用
  fabricLength Float?   // 生地の尺（1反の長さ・尺）- 生地カテゴリのみ使用
  active       Boolean  @default(true)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  productMaterials ProductMaterial[]
}

model MaterialCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("bg-gray-100 text-gray-700")
  unitType  String   @default("piece")  // このカテゴリのデフォルト単位
  parentId  String?  // 階層構造: top → intermediate → leaf
  kind      String   @default("leaf")   // "top" | "intermediate" | "leaf"
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  orderDate   DateTime
  dueDate     DateTime?
  status      String   @default("pending")  // pending | in_progress | completed | cancelled
  // 進捗段階（受注進捗ボード）: received | production | preparing | shipped | cancelled
  stage          String    @default("received")
  stageUpdatedAt DateTime?
  note        String?
  items       OrderItem[]
  shipments   Shipment[]
  drafts      OrderDraft[]
  developmentId String?   // 別注プロジェクトの受注
  development   Development? @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int
  monthlyPlans  String?  // JSON: {"2026-04": 100, "2026-05": 200}
  weeklyPlans   String?  // JSON: 週別配分
  shippedQty    Int      @default(0)
  unitPrice     Int?     // 単価（注文時の価格、Productからコピー）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Production {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  requestDate     DateTime
  dueDate         DateTime?
  status          String   @default("requested")  // requested | in_progress | delivered
  targetMonth     String?  // 対象月 "YYYY-MM"（月次表示・複製の基準）
  provisional     Boolean  @default(false)  // 仮制作（複製直後の下書き。集計・在庫から除外）
  // 社内工程（担当者なし・依頼単位）
  cutDate         DateTime?  // 裁断 完了日
  materialDate    DateTime?  // 資材準備 完了日
  note            String?
  assignments     ProductionAssignment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductionAssignment {
  id            String     @id @default(cuid())
  productionId  String
  production    Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  workerId      String
  worker        Member     @relation(fields: [workerId], references: [id])
  step          String?    // 工程名（裁断/縫製/仕上げ など、任意）
  requestDate   DateTime?  // この担当への依頼日（未設定=製造依頼日にフォールバック）
  quantity      Int        // この内職への割当数
  deliveredQty  Int        @default(0)
  deliveredDate DateTime?
  status        String     @default("requested")  // requested | in_progress | delivered（stageから同期）
  // 6工程パイプライン（対応者ごと）: assigned→cut→material→handover→delivered→inspected
  stage         String     @default("assigned")
  cutDate       DateTime?  // 裁断 完了日
  materialDate  DateTime?  // 資材準備 完了日
  handoverDate  DateTime?  // お渡し 日
  inspectedDate DateTime?  // 検品 完了日
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Development {
  id           String   @id @default(cuid())
  title        String
  description  String?
  status       String   @default("active")  // active | released | paused | abandoned
  // 別注の段階: consult | quote | sample | approved（ここまで量産前） | production | delivered
  phase        String   @default("consult")
  contactId    String?  // 依頼主
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  orders       Order[]
  initiator    String?  // 誰が発案
  startDate    DateTime?
  releasedDate DateTime?
  productId    String?  // リリース時の商品マスタ紐付け
  product      Product? @relation(fields: [productId], references: [id])
  notes        String?
  tasks        Task[]
  milestones   Milestone[]
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// プロジェクトの節目（タスクではなく、期日そのものが意味を持つ点）
// 例: 展示会初日、サンプル提出締切、量産開始
model Milestone {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  title         String
  date          DateTime
  note          String?
  done          Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@index([developmentId])
}

model Shipment {
  id          String   @id @default(cuid())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  shipDate    DateTime
  quantity    Int
  amount      Int      // 出荷時の売上額
  status      String   @default("scheduled")  // scheduled | shipped | delivered
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductForecast {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  month     String   // "2026-05"
  forecast  Int
  source    String?  // manual | prev_year | moving_avg
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, month])
}

model PriceListSnapshot {
  id          String   @id @default(cuid())
  name        String   // 例: "2026年5月価格改定"
  note        String?  // メモ（理由など）
  kind        String   @default("matrix")  // "matrix"(全体) | "customer"(顧客別)
  contactId   String?  // 顧客別アーカイブの対象顧客ID（削除耐性のためFKは張らない）
  contactName String?  // 保存時点の顧客名（表示用）
  contactRate Int?     // 保存時点の掛率(%)
  snappedAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       PriceListItem[]
  @@index([contactId])
}

model PriceListItem {
  id          String   @id @default(cuid())
  snapshotId  String
  snapshot    PriceListSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  productId   String   // 元商品ID（参照のため、削除後も値は保持）
  productCode String?
  productName String
  series      String?
  cost        Int      @default(0)        // 当時の原価
  retailPrice Int?                         // 当時の上代
  prices      String                       // JSON: matrix={ "AmazonJP_110": 150, ... } / customer={ "wholesale":X, "auto":Y, "override":0/1 }
  note        String?                      // 顧客別: 個別価格の理由メモ（保存時点）
  createdAt   DateTime @default(now())
  @@index([snapshotId])
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  stock       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Activity {
  id           String   @id @default(cuid())
  contactId    String
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type         String
  content      String
  activityDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId        String?
  deal          Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  developmentId String?
  development   Development? @relation(fields: [developmentId], references: [id], onDelete: SetNull)
  startDate     DateTime?   // 着手予定日（未設定ならガントは期限から逆算）
  dueDate       DateTime?
  priority      String   @default("medium")
  status        String   @default("todo")
  forStage      String?
  assignee      String?
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== EC販売ダッシュボード (B2C/EC: Shopify/Amazon/Creema/NEXCO 等) =====
// B2Bの受注(Order)とは別系統。チャネル×月×SKU×柄 で売上・数量を集計する。

model EcChannel {
  id        String   @id @default(cuid())
  name      String   @unique // 京都芸美堂 / NEXCO / AmazonUS / AmazonJP / Creema
  kind      String?  // shopify | amazon | creema | consignment | other
  color     String   @default("#3b82f6")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  sales     EcSale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EcSku {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  series    String?     // 西陣 / 友禅 / 伊勢 / その他
  productId String?     // 既存Product(B2B)への任意リンク
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  patterns  EcPattern[]
  sales     EcSale[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model EcPattern {
  id        String   @id @default(cuid())
  skuId     String
  sku       EcSku    @relation(fields: [skuId], references: [id], onDelete: Cascade)
  name      String   // 柄名(カラバリ)
  code      String?  // チャネル側SKU等の識別子(将来の取込用)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  sales     EcSale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skuId, name])
}

model EcSale {
  id        String     @id @default(cuid())
  channelId String
  channel   EcChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  skuId     String
  sku       EcSku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  patternId String?
  pattern   EcPattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)
  yearMonth String     // "2026-05"
  quantity  Int        @default(0)
  revenue   Int        @default(0) // 売上(円, 税込/税抜は運用で統一)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([yearMonth])
  @@index([channelId])
  @@index([skuId])
}

// Slack投稿などでの商品の書き方 → 商品マスタ（受注登録時に確定した対応を学習する）
model ProductAlias {
  id        String   @id @default(cuid())
  label     String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// アプリ全体の設定（value は JSON 文字列）。価格計算の設定は key="pricing"
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Slack #受注 から自動で取り込んだ「確認待ちの受注下書き」
model OrderDraft {
  id            String    @id @default(cuid())
  source        String    @default("slack")
  slackChannel  String?
  slackTs       String?   @unique
  slackUserId   String?
  slackUserName String?
  rawText       String
  status        String    @default("pending") // pending | registered | dismissed | excluded(自動で除外)
  excludedReason String?
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  postedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

// JAN台帳（社内台帳。JANの正はGS1のGJDB）
model JanItem {
  id               String   @id @default(cuid())
  jan              String   @unique
  companyPrefix    String   // GS1事業者コード
  itemCode         Int      // 品目コード
  status           String   @default("used") // used(使用中) | reserved(確保) | free(空き) | discontinued(廃番：再利用しない)
  productName      String?
  nameOther        String?
  patternCode      String?  // 柄コード（確保の場合は用途メモが入ることもある）
  productId        String?  // 商品マスタ（価格計算の商品）へのひも付け
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  amazonListed     Boolean  @default(false)
  amazonComolife   Boolean  @default(false)
  pastAmazonListed Boolean  @default(false)
  pastAmazonCode   String?
  gs1Registered    Boolean  @default(false) // GS1(GJDB)に登録済み。JANの正はGS1
  price            Int?     // 上代（税抜・円）
  brand            String?
  channels         String?  // 使用先（カンマ区切り。例：Amazon JP, よしや）
  legacyRecordNo   Int?     // 旧台帳のレコード番号
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyPrefix, itemCode])
  @@index([productId])
  @@index([status])
}

// GS1事業者コードと採番に使う品目コードの範囲
model JanPrefix {
  id         String   @id @default(cuid())
  prefix     String   @unique
  label      String?
  rangeStart Int      @default(0)
  rangeEnd   Int      @default(999)
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 販売計画シミュレーション：1商品の生産と販売を月ごとに置いてみる（シナリオごとに1件）
model SalesPlan {
  id        String          @id @default(cuid())
  name      String          // 例：3.3寸 2,000個・Amazon重視
  term      String          // 期（例：第10期）。月は期首日から12か月
  adopted   Boolean         @default(false) // 採用したシナリオ（顧客予算の合計に入れる）
  openingStock Int          @default(0)     // 期首の在庫（作ってある分。資金は出ていかない）
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  note      String?
  createdBy String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cells     SalesPlanCell[]

  @@index([term])
}

// 月ごとの数。kind=production（生産）| sale（販売：channel＝顧客カテゴリ、contact＝顧客。顧客未定は空）
model SalesPlanCell {
  id        String    @id @default(cuid())
  planId    String
  plan      SalesPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind      String
  channel   String?
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  month     String    // YYYY-MM
  qty       Int       @default(0)

  @@index([planId])
  @@index([contactId])
}
